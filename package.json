{
  "name": "drinks-stall-uncle",
  "version": "1.0.0",
  "private": true,
  "description": "Don't know how to order kopi? Uncle help you!",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --target=es2020 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --legal-comments=none --outfile=dist/app.js",
    "watch": "npm run build -- --watch",
    "serve": "npm run build -- --servedir=.",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
